# Copy to apps/web/.env (git-ignored) and fill in locally. Never commit real values.
# Server-side only: the Vite dev and preview proxy reads PADDLEOCR_* with loadEnv,
# and Vite exposes only VITE_* values to browser code. The deployed Worker reads
# the job URL and model from wrangler.jsonc vars and the token from a Worker
# secret (`npx wrangler secret put PADDLEOCR_ACCESS_TOKEN`).
PADDLEOCR_ACCESS_TOKEN=replace-me
PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
